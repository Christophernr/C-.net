<Window x:Class="ventanas.informacionContacto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ventanas"
        mc:Ignorable="d"
        Title="informacionContacto" Height="450" Width="800">
    <Grid>
        <Label Content="Nombre" HorizontalAlignment="Left" Height="34" Margin="62,112,0,0" VerticalAlignment="Top" Width="79" FontSize="16"/>
        <Label Content="Numero Telefonico" HorizontalAlignment="Left" Height="34" Margin="26,172,0,0" VerticalAlignment="Top" Width="150" FontSize="16"/>
        <Label Content="Correo" HorizontalAlignment="Left" Height="34" Margin="62,230,0,0" VerticalAlignment="Top" Width="78" FontSize="16"/>
        <Button x:Name="btn_eliminar" Content="Eliminar" HorizontalAlignment="Left" Margin="508,178,0,0" VerticalAlignment="Top" Height="46" Width="94"/>
        <Button x:Name="btn_volver" Content="Volver" HorizontalAlignment="Left" Margin="508,112,0,0" VerticalAlignment="Top" Height="46" Width="94" RenderTransformOrigin="0.115,1.067"/>
        <Button x:Name="btn_modificar" Content="Modificar" HorizontalAlignment="Left" Margin="508,247,0,0" VerticalAlignment="Top" Height="46" Width="94"/>
        <Label x:Name="lbl_nombre_importado" Content="" HorizontalAlignment="Left" Height="34" Margin="211,112,0,0" VerticalAlignment="Top" Width="79" FontSize="16"/>
        <Label x:Name="lbl_numero_importado" Content="" HorizontalAlignment="Left" Height="34" Margin="211,172,0,0" VerticalAlignment="Top" Width="79" FontSize="16"/>
        <Label x:Name="lbl_correo_importado" Content="" HorizontalAlignment="Left" Height="34" Margin="211,230,0,0" VerticalAlignment="Top" Width="79" FontSize="16"/>
        <Label x:Name="lbl_id_importando" Content="" HorizontalAlignment="Left" Height="35" Margin="211,72,0,0" VerticalAlignment="Top" Width="53"/>

    </Grid>
</Window>
