<Window x:Class="ventanas.añadir"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ventanas"
        mc:Ignorable="d"
        Title="añadir" Height="450" Width="800">
    <Grid>
        <Label Content="Nombre" HorizontalAlignment="Left" Height="34" Margin="62,112,0,0" VerticalAlignment="Top" Width="79" FontSize="16"/>
        <TextBox x:Name="txt_nombre" HorizontalAlignment="Left" Margin="181,116,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="156" Height="26" FontSize="14"/>
        <Label Content="Numero Telefonico" HorizontalAlignment="Left" Height="34" Margin="26,172,0,0" VerticalAlignment="Top" Width="150" FontSize="16"/>
        <TextBox x:Name="txt_numero" HorizontalAlignment="Left" Margin="181,176,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="156" Height="26" FontSize="14"/>
        <Label Content="Correo" HorizontalAlignment="Left" Height="34" Margin="62,230,0,0" VerticalAlignment="Top" Width="78" FontSize="16"/>
        <TextBox x:Name="txt_correo" HorizontalAlignment="Left" Margin="181,234,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="156" Height="26" FontSize="14"/>
        <Button x:Name="btn_guardar" Content="Guardar" HorizontalAlignment="Left" Margin="508,106,0,0" VerticalAlignment="Top" Height="46" Width="94"/>
        <Button x:Name="btn_cancelar" Content="Cancelar" HorizontalAlignment="Left" Margin="508,178,0,0" VerticalAlignment="Top" Height="46" Width="94"/>

    </Grid>
</Window>
